    <!-- JavaScript Logic -->
    <script>
        let historyLogs = [];
        let canvas = document.getElementById('tacticalCanvas');
        let ctx = canvas.getContext('2d');

        // Resize Canvas dynamically
        function setupCanvas() {
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * window.devicePixelRatio || rect.width;
            canvas.height = rect.height * window.devicePixelRatio || rect.height;
            drawPlaceholderGrid();
        }

        window.addEventListener('resize', setupCanvas);
        setTimeout(setupCanvas, 100);

        function drawPlaceholderGrid() {
            const w = canvas.width;
            const h = canvas.height;
            ctx.clearRect(0, 0, w, h);

            // Draw Background Grid Lines
            ctx.strokeStyle = '#1e293b';
            ctx.lineWidth = 1;

            const step = 30;
            for (let x = 0; x < w; x += step) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, h);
                ctx.stroke();
            }
            for (let y = 0; y < h; y += step) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(w, y);
                ctx.stroke();
            }

            // Compass Rose Overlay in Center
            ctx.save();
            ctx.strokeStyle = '#334155';
            ctx.fillStyle = '#475569';
            ctx.font = '10px Kantumruuy Pro';
            ctx.textAlign = 'center';
            ctx.fillText('N (00-00)', w / 2, 20);
            ctx.fillText('S (30-00)', w / 2, h - 10);
            ctx.fillText('E (15-00)', w - 30, h / 2);
            ctx.fillText('W (45-00)', 30, h / 2);
            ctx.restore();
        }

        function loadPreset() {
            document.getElementById('x1').value = 48200;
            document.getElementById('y1').value = 15300;
            document.getElementById('x2').value = 51500;
            document.getElementById('y2').value = 18900;
            document.getElementById('base_azimuth').value = 0; // 00-00 North
            calculateData();
        }

        function resetForm() {
            document.getElementById('x1').value = '';
            document.getElementById('y1').value = '';
            document.getElementById('x2').value = '';
            document.getElementById('y2').value = '';
            document.getElementById('base_azimuth').value = '';

            document.getElementById('res_dist').innerText = '-';
            document.getElementById('res_dist_km').innerText = '-';
            document.getElementById('res_charge').innerText = '-';
            document.getElementById('res_mil6000').innerText = '-';
            document.getElementById('res_mil6000_raw').innerText = '-';
            document.getElementById('res_dev').innerText = '-';
            document.getElementById('res_deg').innerText = '-';
            document.getElementById('res_mil6400').innerText = '-';

            document.getElementById('calc_status').innerText = 'រង់ចាំការបញ្ចូលទិន្នន័យ';
            document.getElementById('calc_status').className = 'text-xs px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700';

            drawPlaceholderGrid();
        }

        function calculateData() {
            const x1 = parseFloat(document.getElementById('x1').value);
            const y1 = parseFloat(document.getElementById('y1').value);
            const x2 = parseFloat(document.getElementById('x2').value);
            const y2 = parseFloat(document.getElementById('y2').value);
            const baseAzimuth = parseFloat(document.getElementById('base_azimuth').value) || 0;

            if (isNaN(x1) || isNaN(y1) || isNaN(x2) || isNaN(y2)) {
                alert("សូមបញ្ចូលលេខនិយាមការ X និង Y ឲ្យបានគ្រប់ជ្រុងជ្រោយ!");
                return;
            }

            const dx = x2 - x1;
            const dy = y2 - y1;

            // 1. Distance Calculation
            const distance = Math.sqrt(dx * dx + dy * dy);

            // 2. Azimuth Calculation
            let azimuthRad = Math.atan2(dx, dy);
            if (azimuthRad < 0) {
                azimuthRad += 2 * Math.PI;
            }
            const azimuthDeg = azimuthRad * (180 / Math.PI);

            // Conversion to Mils
            const mils6000 = azimuthDeg * (6000 / 360);
            const mils6400 = azimuthDeg * (6400 / 360);

            // XX-XX formatting for 6000 mils
            const mainMil = Math.floor(mils6000 / 100).toString().padStart(2, '0');
            const subMil = Math.round(mils6000 % 100).toString().padStart(2, '0');
            const formattedMil6000 = `${mainMil}-${subMil}`;

            // 3. Deviation from Base Azimuth
            const baseDeg = baseAzimuth * (360 / 6000);
            let devDeg = azimuthDeg - baseDeg;

            if (devDeg > 180) devDeg -= 360;
            if (devDeg < -180) devDeg += 360;

            const devMils6000 = devDeg * (6000 / 360);
            const direction = devMils6000 >= 0 ? "បត់ស្តាំ" : "បត់ឆ្វេង";
            const devFormatted = `${direction} ${Math.abs(devMils6000).toFixed(1)} មីល`;

            // 4. Charge Selection (120mm Mortar Table standard)
            let charge = "";
            let chargeClass = "text-emerald-400";
            if (distance < 400) {
                charge = "ជិតពេក (< 400m)";
                chargeClass = "text-rose-400";
            } else if (distance <= 1200) {
                charge = "សាស ០ (Charge 0)";
            } else if (distance <= 2500) {
                charge = "សាស ១ (Charge 1)";
            } else if (distance <= 4000) {
                charge = "សាស ២ (Charge 2)";
            } else if (distance <= 5500) {
                charge = "សាស ៣ (Charge 3)";
            } else if (distance <= 7200) {
                charge = "សាស ៤ (Charge 4)";
            } else {
                charge = "ឆ្ងាយពេក (> 7200m)";
                chargeClass = "text-rose-400";
            }

            // Update UI Elements
            document.getElementById('res_dist').innerText = `${distance.toFixed(1)} ម៉ែត្រ`;
            document.getElementById('res_dist_km').innerText = `(${ (distance / 1000).toFixed(2) } គីឡូម៉ែត្រ)`;
           
            const chargeElem = document.getElementById('res_charge');
            chargeElem.innerText = charge;
            chargeElem.className = `text-base font-bold ${chargeClass}`;

            document.getElementById('res_mil6000').innerText = formattedMil6000;
            document.getElementById('res_mil6000_raw').innerText = `(${mils6000.toFixed(1)} មីល)`;

            document.getElementById('res_dev').innerText = devFormatted;
            document.getElementById('res_deg').innerText = `${azimuthDeg.toFixed(2)}°`;
            document.getElementById('res_mil6400').innerText = `${mils6400.toFixed(1)} មីល`;

            document.getElementById('calc_status').innerText = 'គណនារួចរាល់';
            document.getElementById('calc_status').className = 'text-xs px-2.5 py-0.5 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800';

            // Render Map Visualization
            renderMap(x1, y1, x2, y2, baseAzimuth, azimuthRad);

            // Add to History
            addHistoryLog(x1, y1, x2, y2, distance, formattedMil6000, devFormatted, charge);
        }

        function renderMap(x1, y1, x2, y2, baseAzimuthMil, azimuthRad) {
            drawPlaceholderGrid();

            const w = canvas.width;
            const h = canvas.height;
            const margin = 50;

            // Calculate bounding box and scale
            const minX = Math.min(x1, x2);
            const maxX = Math.max(x1, x2);
            const minY = Math.min(y1, y2);
            const maxY = Math.max(y1, y2);

            let spanX = Math.abs(maxX - minX) || 1000;
            let spanY = Math.abs(maxY - minY) || 1000;

            const scaleX = (w - margin * 2) / spanX;
            const scaleY = (h - margin * 2) / spanY;
            const scale = Math.min(scaleX, scaleY);

            // Screen Mapping Functions
            function toScreenX(x) {
                return margin + (x - minX) * scale + (w - margin * 2 - spanX * scale) / 2;
            }
            function toScreenY(y) {
                // Cartographic Y increases upwards, Canvas Y increases downwards
                return h - (margin + (y - minY) * scale + (h - margin * 2 - spanY * scale) / 2);
            }

            const p1 = { x: toScreenX(x1), y: toScreenY(y1) };
            const p2 = { x: toScreenX(x2), y: toScreenY(y2) };

            // Draw Line of Fire
            ctx.save();
            ctx.strokeStyle = '#f59e0b'; // Amber Line
            ctx.lineWidth = 2.5;
            ctx.setLineDash([6, 4]);
            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
            ctx.restore();

            // Draw Base Azimuth Line from Gun Position
            if (baseAzimuthMil > 0) {
                const baseDeg = baseAzimuthMil * (360 / 6000);
                const baseRad = baseDeg * (Math.PI / 180);
                const baseLen = 120;
                const bx = p1.x + baseLen * Math.sin(baseRad);
                const by = p1.y - baseLen * Math.cos(baseRad);

                ctx.save();
                ctx.strokeStyle = '#38bdf8'; // Sky Blue Line
                ctx.lineWidth = 1.5;
                ctx.setLineDash([3, 3]);
                ctx.beginPath();
                ctx.moveTo(p1.x, p1.y);
                ctx.lineTo(bx, by);
                ctx.stroke();

                ctx.fillStyle = '#38bdf8';
                ctx.font = '10px Kantumruuy Pro';
                ctx.fillText('ទិសគោល', bx + 5, by);
                ctx.restore();
            }

            // Draw Gun Position (Green Point)
            ctx.save();
            ctx.fillStyle = '#10b981';
            ctx.beginPath();
            ctx.arc(p1.x, p1.y, 7, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 1.5;
            ctx.stroke();

            ctx.fillStyle = '#34d399';
            ctx.font = 'bold 11px Kantumruuy Pro';
            ctx.fillText('ទីតាំងបាញ់', p1.x + 10, p1.y - 10);
            ctx.restore();

            // Draw Target Position (Red Crosshair)
            ctx.save();
            ctx.strokeStyle = '#f43f5e';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(p2.x, p2.y, 8, 0, Math.PI * 2);
            ctx.moveTo(p2.x - 12, p2.y);
            ctx.lineTo(p2.x + 12, p2.y);
            ctx.moveTo(p2.x, p2.y - 12);
            ctx.lineTo(p2.x, p2.y + 12);
            ctx.stroke();

            ctx.fillStyle = '#fb7185';
            ctx.font = 'bold 11px Kantumruuy Pro';
            ctx.fillText('គោលដៅ', p2.x + 12, p2.y + 15);
            ctx.restore();
        }

        function addHistoryLog(x1, y1, x2, y2, dist, mil6000, dev, charge) {
            const timeStr = new Date().toLocaleTimeString('km-KH', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
           
            historyLogs.unshift({
                id: historyLogs.length + 1,
                gun: `${x1}, ${y1}`,
                target: `${x2}, ${y2}`,
                dist: `${dist.toFixed(1)}m`,
                mil6000: mil6000,
                dev: dev,
                charge: charge,
                time: timeStr
            });

            renderHistoryTable();
        }

        function renderHistoryTable() {
            const tbody = document.getElementById('history_body');
            if (historyLogs.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="p-4 text-center text-slate-500">មិនទាន់មានទិន្នន័យគណនានៅឡើយទេ</td></tr>`;
                return;
            }

            tbody.innerHTML = historyLogs.map(item => `
                <tr class="hover:bg-slate-800/50 transition">
                    <td class="p-2.5 text-slate-400 font-mono">${item.id}</td>
                    <td class="p-2.5 font-medium text-emerald-300">${item.gun}</td>
                    <td class="p-2.5 font-medium text-rose-300">${item.target}</td>
                    <td class="p-2.5 text-amber-400 font-bold">${item.dist}</td>
                    <td class="p-2.5 text-sky-400 font-bold">${item.mil6000}</td>
                    <td class="p-2.5 text-purple-300">${item.dev}</td>
                    <td class="p-2.5 text-slate-200">${item.charge}</td>
                    <td class="p-2.5 text-right text-slate-500 font-mono text-[10px]">${item.time}</td>
                </tr>
            `).join('');
        }

        function clearHistory() {
            historyLogs = [];
            renderHistoryTable();
        }
    </script>
